---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../config/site.json";
---

<BaseLayout title="Roadmap and Changelog" description={`Public roadmap and project updates for ${site.name}.`} lang="en">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-ink mb-6">Roadmap and Changelog</h1>
    <p class="text-stone text-lg leading-relaxed mb-12">
      [PLACEHOLDER: A public look at what we are building, what is planned next, and recent releases across all projects.]
    </p>

    <div class="space-y-6">
      <div class="p-6 bg-card border border-line rounded-lg">
        <span class="inline-block px-2.5 py-0.5 text-xs font-mono font-medium uppercase tracking-wide rounded bg-forest/10 text-forest mb-2">
          In progress
        </span>
        <h2 class="font-heading text-lg font-semibold text-ink mb-2">
          [PLACEHOLDER: Phase 1 website skeleton and release infrastructure]
        </h2>
        <p class="text-sm text-stone leading-relaxed">
          [PLACEHOLDER: Setting up core website foundation, multilingual routing, accessible component system, and catalog.]
        </p>
      </div>

      <div class="p-6 bg-card border border-line rounded-lg">
        <span class="inline-block px-2.5 py-0.5 text-xs font-mono font-medium uppercase tracking-wide rounded bg-sand text-stone mb-2">
          Upcoming
        </span>
        <h2 class="font-heading text-lg font-semibold text-ink mb-2">
          [PLACEHOLDER: Static search and interactive release filters]
        </h2>
        <p class="text-sm text-stone leading-relaxed">
          [PLACEHOLDER: Adding client-side search and category filtering for the release catalog.]
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

