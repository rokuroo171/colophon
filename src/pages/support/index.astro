---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../config/site.json";
---

<BaseLayout title="Support" description={`Support the open-source mission of ${site.name}.`} lang="en">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-ink mb-6">Support {site.name}</h1>
    <p class="text-stone text-lg leading-relaxed mb-12">
      [PLACEHOLDER: Independent open-source development thrives with the backing of users and sponsors. Here is how you can support our work.]
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="p-6 bg-card border border-line rounded-lg">
        <h2 class="font-heading text-xl font-semibold text-ink mb-3">Financial sponsorship</h2>
        <p class="text-stone text-sm leading-relaxed mb-6">
          [PLACEHOLDER: Support development costs, server infrastructure, and code signing certificates.]
        </p>
        <span class="inline-block px-4 py-2 border border-line rounded text-xs font-mono text-stone bg-sand/40">
          [PLACEHOLDER: Sponsorship options coming soon]
        </span>
      </div>

      <div class="p-6 bg-card border border-line rounded-lg">
        <h2 class="font-heading text-xl font-semibold text-ink mb-3">Contribute non-financially</h2>
        <p class="text-stone text-sm leading-relaxed mb-6">
          [PLACEHOLDER: Code contributions, docs proofreading, bug reports, and sharing our projects with colleagues.]
        </p>
        <a href="/docs/contributing/" class="text-sm font-medium text-terracotta hover:text-forest transition-colors duration-200">
          Read contributor guide &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

