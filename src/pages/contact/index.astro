---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../config/site.json";
---

<BaseLayout title="Contact" description={`Get in touch with the ${site.name} team.`} lang="en">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-ink mb-6">Contact</h1>
    <p class="text-stone text-lg leading-relaxed mb-8">
      [PLACEHOLDER: Get in touch for partnerships, technical feedback, press inquiries, or questions about {site.name} releases.]
    </p>

    <div class="p-6 bg-card border border-line rounded-lg space-y-4">
      <div>
        <p class="text-xs font-mono uppercase tracking-wide text-stone mb-1">GitHub</p>
        <a href={site.repo} class="text-ink hover:text-terracotta transition-colors duration-200" rel="noopener noreferrer" target="_blank">
          {site.repo}
        </a>
      </div>
      <div class="border-t border-line pt-4">
        <p class="text-xs font-mono uppercase tracking-wide text-stone mb-1">Email</p>
        <p class="text-stone text-sm">
          [PLACEHOLDER: contact@example.org]
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

