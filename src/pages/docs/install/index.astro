---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import site from "../../../config/site.json";
---

<BaseLayout title="Install and Self-host" description={`Installation guides for ${site.name} releases.`} lang="en">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-ink mb-6">Install and Self-host</h1>
    <p class="text-stone text-lg leading-relaxed mb-6">
      [PLACEHOLDER: Overview and general instructions for installing desktop releases and deploying self-hosted services published by {site.name}.]
    </p>
    <div class="p-6 bg-card border border-line rounded-lg">
      <h2 class="font-heading text-xl font-semibold text-ink mb-3">Self-hosting philosophy</h2>
      <p class="text-stone text-sm leading-relaxed mb-4">
        [PLACEHOLDER: All services provide containerized images, simple environment configs, and clear data persistence guidelines.]
      </p>
      <a href="/releases/" class="text-sm font-medium text-terracotta hover:text-forest transition-colors duration-200">
        Browse releases to see specific install instructions &rarr;
      </a>
    </div>
  </section>
</BaseLayout>

