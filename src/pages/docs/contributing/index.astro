---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import site from "../../../config/site.json";
---

<BaseLayout title="Contributor Guide" description={`How to contribute to ${site.name} projects.`} lang="en">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-ink mb-6">Contributor Guide</h1>
    <p class="text-stone text-lg leading-relaxed mb-6">
      [PLACEHOLDER: How to contribute code, write documentation, and report issues for {site.name} projects.]
    </p>
    <div class="space-y-4">
      <div class="p-6 bg-card border border-line rounded-lg">
        <h2 class="font-heading text-lg font-semibold text-ink mb-2">Code of conduct</h2>
        <p class="text-sm text-stone leading-relaxed">
          [PLACEHOLDER: We are committed to providing a friendly, safe, and welcoming environment for all contributors.]
        </p>
      </div>
      <div class="p-6 bg-card border border-line rounded-lg">
        <h2 class="font-heading text-lg font-semibold text-ink mb-2">Finding your first issue</h2>
        <p class="text-sm text-stone leading-relaxed">
          [PLACEHOLDER: Check out issues labeled good first issue across our repositories to get started.]
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

