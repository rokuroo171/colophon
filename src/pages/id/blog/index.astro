---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import site from "../../../config/site.json";
---

<BaseLayout title="Blog" description={`Pembaruan, tulisan, dan pengumuman dari ${site.name}.`} lang="id">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-ink mb-6">Blog</h1>
    <p class="text-stone text-lg leading-relaxed mb-12">
      [PLACEHOLDER: Catatan seputar rekayasa perangkat lunak, refleksi rilis, dan kabar terbaru dari {site.name}.]
    </p>

    <div class="space-y-8">
      <article class="p-6 bg-card border border-line rounded-lg">
        <time datetime="2026-11-01" class="text-xs font-mono text-stone">1 November 2026</time>
        <h2 class="font-heading text-xl font-semibold text-ink mt-2 mb-2">
          [PLACEHOLDER: Selamat Datang di Colophon]
        </h2>
        <p class="text-stone text-sm leading-relaxed">
          [PLACEHOLDER: Memulai langkah sebagai penerbit independen aplikasi dan layanan sumber terbuka.]
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

