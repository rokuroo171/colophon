---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../config/site.json";
---

<BaseLayout title="Vision" description={`The vision and principles behind ${site.name}.`} lang="en">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-ink mb-6">Vision</h1>
    <p class="text-stone text-lg leading-relaxed mb-6">
      [PLACEHOLDER: The principles and long-term direction behind {site.name}. We believe software should be crafted with care, respect user autonomy, and remain completely open.]
    </p>
    <p class="text-stone text-base leading-relaxed">
      [PLACEHOLDER: As an indie publisher, our focus is on building sustainable tools that do one thing exceptionally well.]
    </p>
  </section>
</BaseLayout>

