---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
const isId = lang === "id";
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-terracotta focus:text-white focus:rounded focus:font-body focus:text-sm focus:shadow-md"
>
  {isId ? "Langsung ke konten" : "Skip to content"}
</a>

