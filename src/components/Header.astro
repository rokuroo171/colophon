---
import site from "../config/site.json";

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
const isId = lang === "id";
const prefix = isId ? "/id" : "";

const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/id(\/|$)/, "/") || "/";
const altUrl = isId
  ? (cleanPath === "/" ? "/" : cleanPath)
  : (cleanPath === "/" ? "/id/" : `/id${cleanPath}`);

const navItems = [
  { href: `${prefix}/releases/`, label: isId ? "Rilis" : "Releases" },
  { href: `${prefix}/docs/install/`, label: isId ? "Dokumentasi" : "Docs" },
  { href: `${prefix}/blog/`, label: "Blog" },
  { href: `${prefix}/roadmap/`, label: isId ? "Peta Jalan" : "Roadmap" },
  { href: `${prefix}/support/`, label: isId ? "Dukungan" : "Support" }
];
---

<header class="border-b border-line bg-card" role="banner">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16" aria-label={isId ? "Navigasi utama" : "Main navigation"}>
    <a href={prefix ? `${prefix}/` : "/"} class="font-heading text-xl font-semibold text-ink no-underline hover:text-terracotta transition-colors duration-200">
      {site.name}
    </a>

    <ul class="hidden md:flex items-center gap-6 list-none m-0 p-0 text-sm font-body" role="list">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="text-stone no-underline hover:text-terracotta transition-colors duration-200">
            {item.label}
          </a>
        </li>
      ))}

      <li class="border-l border-line pl-6">
        <a
          href={altUrl}
          class="text-stone no-underline hover:text-terracotta transition-colors duration-200 font-mono text-xs uppercase tracking-wide"
          lang={isId ? "en" : "id"}
          aria-label={isId ? "Switch to English" : "Ganti ke Bahasa Indonesia"}
        >
          {isId ? "EN" : "ID"}
        </a>
      </li>

      <li>
        <a
          href={site.repo}
          class="inline-flex items-center gap-1.5 text-sm text-stone no-underline hover:text-terracotta transition-colors duration-200"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </li>
    </ul>

    <button
      type="button"
      class="md:hidden p-2 text-stone hover:text-terracotta transition-colors duration-200"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-menu-toggle
    >
      <span class="sr-only">{isId ? "Buka menu" : "Open menu"}</span>
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="md:hidden hidden border-t border-line bg-card" role="navigation" aria-label={isId ? "Menu navigasi seluler" : "Mobile navigation menu"}>
    <ul class="flex flex-col gap-1 px-4 py-4 list-none m-0" role="list">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="block py-2 text-stone no-underline hover:text-terracotta transition-colors duration-200">
            {item.label}
          </a>
        </li>
      ))}
      <li class="border-t border-line mt-2 pt-2 flex items-center justify-between">
        <a
          href={altUrl}
          class="py-2 text-stone no-underline hover:text-terracotta transition-colors duration-200 font-mono text-xs uppercase tracking-wide"
          lang={isId ? "en" : "id"}
        >
          {isId ? "English" : "Bahasa Indonesia"}
        </a>
        <a
          href={site.repo}
          class="inline-flex items-center gap-1.5 py-2 text-stone no-underline hover:text-terracotta transition-colors duration-200"
          rel="noopener noreferrer"
          target="_blank"
        >
          GitHub
        </a>
      </li>
    </ul>
  </div>
</header>

