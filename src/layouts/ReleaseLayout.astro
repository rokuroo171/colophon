---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  kind: "desktop" | "service" | "tool";
  version: string;
  status: "alpha" | "beta" | "stable";
  tagline: string;
  repo: string;
  download: string;
  features?: Array<{ title: string; description: string }>;
  changelog?: Array<{ version: string; date: string; summary: string }>;
  installTabs?: Array<{ label: string; code: string }>;
  lang?: string;
}

const {
  title,
  kind,
  version,
  status,
  tagline,
  repo,
  download,
  features = [],
  changelog = [],
  installTabs = [],
  lang = "en",
} = Astro.props;

const isId = lang === "id";

const kindLabels = {
  desktop: isId ? "Aplikasi Desktop" : "Desktop App",
  service: isId ? "Layanan" : "Service",
  tool: isId ? "Perkakas" : "Tool",
};

const statusLabels = {
  stable: isId ? "Stabil" : "Stable",
  beta: "Beta",
  alpha: "Alpha",
};

const statusStyles = {
  stable: "bg-forest/10 text-forest",
  beta: "bg-terracotta/10 text-terracotta",
  alpha: "bg-sand text-stone",
};
---

<BaseLayout title={title} description={tagline} lang={lang}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- Hero Section -->
    <header class="mb-14">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="inline-block px-2.5 py-0.5 text-xs font-mono font-medium uppercase tracking-wide rounded bg-sand text-stone">
          {kindLabels[kind]}
        </span>
        <span class={`inline-block px-2.5 py-0.5 text-xs font-mono font-medium rounded ${statusStyles[status]}`}>
          {statusLabels[status]} &middot; v{version}
        </span>
      </div>

      <h1 class="font-heading text-4xl sm:text-5xl font-semibold text-ink mb-4">{title}</h1>
      <p class="text-xl text-stone leading-relaxed max-w-2xl">{tagline}</p>

      <div class="flex flex-wrap gap-3 mt-8">
        {download && (
          <a
            href={download}
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-terracotta text-white font-body text-sm font-medium rounded no-underline hover:bg-terracotta/90 transition-colors duration-200"
          >
            {isId ? "Unduh" : "Download"}
          </a>
        )}
        {repo && (
          <a
            href={repo}
            class="inline-flex items-center gap-2 px-5 py-2.5 border border-line text-ink font-body text-sm font-medium rounded no-underline hover:border-stone transition-colors duration-200"
            rel="noopener noreferrer"
            target="_blank"
          >
            {isId ? "Lihat repo" : "View repo"}
          </a>
        )}
      </div>
    </header>

    <!-- Markdown Overview Content -->
    <section class="mb-14 text-stone leading-relaxed text-lg" aria-label={isId ? "Deskripsi rilis" : "Release overview"}>
      <slot />
    </section>

    <!-- Features Grid -->
    {features.length > 0 && (
      <section class="mb-14" aria-labelledby="features-heading">
        <h2 id="features-heading" class="font-heading text-2xl font-semibold text-ink mb-6">
          {isId ? "Fitur utama" : "Features"}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feature) => (
            <div class="p-6 bg-card border border-line rounded-lg">
              <h3 class="font-heading text-lg font-semibold text-ink mb-2">{feature.title}</h3>
              <p class="text-sm text-stone leading-relaxed">{feature.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Installation Tabs -->
    {installTabs.length > 0 && (
      <section class="mb-14" aria-labelledby="install-heading">
        <h2 id="install-heading" class="font-heading text-2xl font-semibold text-ink mb-6">
          {isId ? "Instalasi" : "Install"}
        </h2>
        <div class="bg-card border border-line rounded-lg overflow-hidden" data-tabs-container>
          <div class="flex border-b border-line overflow-x-auto" role="tablist" aria-label={isId ? "Platform instalasi" : "Install platform"}>
            {installTabs.map((tab, idx) => (
              <button
                role="tab"
                type="button"
                id={`tab-${idx + 1}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`tabpanel-${idx + 1}`}
                class={`px-5 py-3 text-sm font-mono text-stone hover:text-ink transition-colors duration-200 whitespace-nowrap ${
                  idx === 0 ? "border-b-2 border-terracotta text-ink font-semibold" : ""
                }`}
                data-install-tab={String(idx + 1)}
              >
                {tab.label}
              </button>
            ))}
          </div>
          {installTabs.map((tab, idx) => (
            <div
              role="tabpanel"
              id={`tabpanel-${idx + 1}`}
              aria-labelledby={`tab-${idx + 1}`}
              class={`p-4 ${idx !== 0 ? "hidden" : ""}`}
              data-install-panel={String(idx + 1)}
            >
              <div class="code-container relative">
                <pre class="bg-sand rounded p-4 pr-20 overflow-x-auto text-sm font-mono text-ink"><code>{tab.code}</code></pre>
                <button
                  type="button"
                  class="absolute top-3 right-3 px-2.5 py-1 text-xs font-mono text-stone bg-card border border-line rounded hover:text-ink hover:border-stone transition-colors duration-200"
                  data-copy-button
                  aria-label={isId ? "Salin perintah terminal" : "Copy command"}
                >
                  {isId ? "Salin" : "Copy"}
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Changelog Preview -->
    {changelog.length > 0 && (
      <section class="mb-14" aria-labelledby="changelog-heading">
        <h2 id="changelog-heading" class="font-heading text-2xl font-semibold text-ink mb-6">
          {isId ? "Perubahan terbaru" : "Recent changes"}
        </h2>
        <ul class="space-y-4 list-none m-0 p-0" role="list">
          {changelog.map((entry) => (
            <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 pb-4 border-b border-line last:border-b-0">
              <span class="text-xs font-mono text-stone whitespace-nowrap">
                v{entry.version} &middot; {entry.date}
              </span>
              <span class="text-sm text-ink leading-relaxed">{entry.summary}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

